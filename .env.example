# DocAudit AI Configuration

# Environment
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# AI Providers (Optional - system falls back gracefully to internal heuristic engine if none provided)
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Provider Selection: auto, gemini, openai, ollama, mock
DEFAULT_LLM_PROVIDER=auto

# Vector Store: local (zero-dependency SQLite) or pgvector (PostgreSQL)
VECTOR_STORE_TYPE=local
DATABASE_URL=sqlite:///./data/docaudit.db
REDIS_URL=redis://localhost:6379/0
